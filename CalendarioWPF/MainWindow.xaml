<Window x:Class="CalendarioWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CalendarioWPF"
        mc:Ignorable="d"
        Title="Gestor de Vacaciones Pro" Height="850" Width="1350"
        WindowStartupLocation="CenterScreen" Background="#F8FAFC"
        FontFamily="Segoe UI, Inter, Arial">
    
    <Window.Resources>
        <!-- Paleta de Colores y Estilos -->
        <SolidColorBrush x:Key="ColorPrimary" Color="#6366F1"/>
        <SolidColorBrush x:Key="ColorPrimaryHover" Color="#4F46E5"/>
        <SolidColorBrush x:Key="ColorAccent" Color="#10B981"/>
        <SolidColorBrush x:Key="ColorAccentHover" Color="#059669"/>
        <SolidColorBrush x:Key="ColorDanger" Color="#EF4444"/>
        <SolidColorBrush x:Key="ColorDangerHover" Color="#DC2626"/>
        <SolidColorBrush x:Key="ColorBorder" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="ColorTextMain" Color="#0F172A"/>
        <SolidColorBrush x:Key="ColorTextMuted" Color="#64748B"/>
        <SolidColorBrush x:Key="ColorBgCard" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ColorBgApp" Color="#F8FAFC"/>

        <!-- Colores del Calendario -->
        <SolidColorBrush x:Key="ColorWeekend" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="ColorWeekendText" Color="#6B7280"/>
        <SolidColorBrush x:Key="ColorFestivo" Color="#FEE2E2"/>
        <SolidColorBrush x:Key="ColorFestivoText" Color="#991B1B"/>
        <SolidColorBrush x:Key="ColorVacacionBase" Color="#DBEAFE"/>
        <SolidColorBrush x:Key="ColorVacacionText" Color="#1E40AF"/>
        <SolidColorBrush x:Key="ColorVacacionOtroAño" Color="#F3E8FF"/>
        <SolidColorBrush x:Key="ColorVacacionOtroAñoText" Color="#6B21A8"/>

        <!-- Estilo de Tarjetas -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ColorBgCard}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ColorBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" Color="#000000" Opacity="0.04" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo de Encabezados de Tarjeta -->
        <Style x:Key="CardHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource ColorTextMain}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Estilo de Botón Estándar -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource ColorTextMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ColorBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo Botón Primario -->
        <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource ColorPrimary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource ColorPrimaryHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo Botón Peligro -->
        <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource ColorDanger}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource ColorDangerHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo Botón Acento -->
        <Style x:Key="BtnAccent" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource ColorAccent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource ColorAccentHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <!-- ================= MENÚ SUPERIOR ================= -->
        <DockPanel DockPanel.Dock="Top" Background="#F1F5F9" LastChildFill="True">
            <Border DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,16,0" Padding="6,2" Background="#EEF2F6" BorderBrush="{StaticResource ColorBorder}" BorderThickness="1" CornerRadius="4">
                <TextBlock x:Name="MenuLabelActiveYear" Text="Año de vacaciones: 2026" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource ColorPrimary}"/>
            </Border>
            <Menu Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="{StaticResource ColorBorder}" Padding="8,4">
                <MenuItem Header="_Archivo">
                    <MenuItem Header="⚙️ _Configuración..." Click="MenuConfiguracion_Click"/>
                    <Separator/>
                    <MenuItem Header="🚪 _Salir" Click="MenuSalir_Click"/>
                </MenuItem>
                <MenuItem Header="_Edición">
                    <MenuItem x:Name="MenuMarcarVacaciones" Header="🏖️ Modo: Marcar Vacaciones" IsCheckable="True" IsChecked="True" Click="MenuMarcarVacaciones_Click"/>
                    <MenuItem x:Name="MenuMarcarFestivos" Header="🚩 Modo: Marcar Festivos Oficiales" IsCheckable="True" IsChecked="False" Click="MenuMarcarFestivos_Click"/>
                    <Separator/>
                    <MenuItem Header="🧹 _Limpiar Todo el Plan..." Click="BtnLimpiarTodo_Click"/>
                </MenuItem>
                <MenuItem Header="_Datos (Imp/Exp)">
                    <MenuItem Header="📂 _Importar Datos (JSON/CSV)..." Click="BtnImportar_Click"/>
                    <Separator/>
                    <MenuItem Header="📤 Exportar Configuración">
                        <MenuItem Header="JSON - Todo (Copia Seguridad)" Click="ExportarTodoJson_Click"/>
                        <MenuItem Header="JSON - Trabajadores" Click="ExportarTrabajadoresJson_Click"/>
                        <MenuItem Header="CSV - Trabajadores" Click="ExportarTrabajadoresCsv_Click"/>
                        <MenuItem Header="JSON - Festivos" Click="ExportarFestivosJson_Click"/>
                        <MenuItem Header="CSV - Festivos" Click="ExportarFestivosCsv_Click"/>
                    </MenuItem>
                    <MenuItem Header="📤 Exportar Asignaciones">
                        <MenuItem Header="JSON - Vacaciones" Click="ExportarVacacionesJson_Click"/>
                        <MenuItem Header="CSV - Vacaciones" Click="ExportarVacacionesCsv_Click"/>
                        <MenuItem Header="CSV - Calendario Gantt Plano" Click="ExportarCsvGantt_Click"/>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="📄 Generar Reporte PDF Mensual..." Click="BtnPdfMensual_Click"/>
                    <MenuItem Header="📄 Generar Reporte PDF Gantt..." Click="BtnPdfGantt_Click"/>
                    <MenuItem Header="📊 Generar Libro Excel Gantt..." Click="BtnExcelGantt_Click"/>
                </MenuItem>
                <MenuItem Header="A_yuda">
                    <MenuItem Header="❓ Mostrar Ayuda" Click="BtnAyuda_Click"/>
                    <Separator/>
                    <MenuItem Header="📋 Ver Registro de Logs..." Click="BtnVerLogs_Click"/>
                </MenuItem>
            </Menu>
        </DockPanel>
<!-- ================= BARRA DE ESTADO ================= -->
        <StatusBar x:Name="MainStatusBar" DockPanel.Dock="Bottom" Background="#F1F5F9" BorderBrush="{StaticResource ColorBorder}" BorderThickness="0,1,0,0" Height="28">
            <StatusBarItem>
                <TextBlock x:Name="StatusBarText" Text="Listo" FontSize="12" Foreground="{StaticResource ColorTextMuted}"/>
            </StatusBarItem>
        </StatusBar>
        
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <!-- Fila 0: Header -->
                <RowDefinition Height="Auto"/>
                <!-- Fila 1: Toolbar del Trabajador Activo -->
                <RowDefinition Height="Auto"/>
                <!-- Fila 2: Cuerpo Principal -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ================= HEADER ================= -->
            <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,12">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <!-- Selector de Año -->
                    <Border BorderBrush="{StaticResource ColorBorder}" BorderThickness="1" CornerRadius="8" Background="White" Padding="2" Height="38">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnPrevYear" Width="30" Content="◀" Background="Transparent" BorderThickness="0" Click="BtnPrevYear_Click"/>
                            <TextBlock x:Name="LabelYear" Text="2026" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Padding="10,0" Foreground="{StaticResource ColorTextMain}"/>
                            <Button x:Name="BtnNextYear" Width="30" Content="▶" Background="Transparent" BorderThickness="0" Click="BtnNextYear_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📅" FontSize="26" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <!-- Título editable de la página -->
                    <TextBox x:Name="PageTitleInput" Text="Planificación de Vacaciones..." FontSize="20" FontWeight="Bold" 
                             Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent"
                             VerticalAlignment="Center" Width="400" Padding="2" Foreground="{StaticResource ColorPrimary}"
                             LostFocus="PageTitleInput_LostFocus">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource ColorPrimary}"/>
                                    </Trigger>
                                    <Trigger Property="IsFocused" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource ColorPrimary}"/>
                                        <Setter Property="Background" Value="#F1F5F9"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </StackPanel>
            </DockPanel>

            <!-- ================= TOOLBAR DEL TRABAJADOR ================= -->
            <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="{StaticResource ColorBorder}" BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- 0 -->
                        <ColumnDefinition Width="200"/> <!-- 1 -->
                        <ColumnDefinition Width="Auto"/> <!-- 2 -->
                        <ColumnDefinition Width="120"/> <!-- 3 -->
                        <ColumnDefinition Width="15"/> <!-- 4 -->
                        <ColumnDefinition Width="Auto"/> <!-- 5 -->
                        <ColumnDefinition Width="Auto"/> <!-- 6 -->
                        <ColumnDefinition Width="40"/> <!-- 7 -->
                        <ColumnDefinition Width="Auto"/> <!-- 8 -->
                        <ColumnDefinition Width="15"/> <!-- 9 -->
                        <ColumnDefinition Width="Auto"/> <!-- 10 -->
                        <ColumnDefinition Width="Auto"/> <!-- 11 -->
                        <ColumnDefinition Width="40"/> <!-- 12 -->
                        <ColumnDefinition Width="Auto"/> <!-- 13 -->
                        <ColumnDefinition Width="25"/> <!-- 14 -->
                        <ColumnDefinition Width="*"/> <!-- 15 -->
                    </Grid.ColumnDefinitions>

                    <!-- Trabajador -->
                    <TextBlock Grid.Column="0" Text="👤 Trabajador:" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource ColorTextMain}"/>
                    <ComboBox x:Name="SelectWorker" Grid.Column="1" Height="32" FontSize="13" SelectionChanged="SelectWorker_SelectionChanged" VerticalContentAlignment="Center"/>

                    <!-- Filtro Dpto -->
                    <TextBlock Grid.Column="2" Text="Filtro Dpto:" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="15,0,6,0" Foreground="{StaticResource ColorTextMuted}"/>
                    <ComboBox x:Name="CmbFiltroDpto" Grid.Column="3" Height="26" FontSize="12" SelectionChanged="CmbFiltroDpto_SelectionChanged" VerticalContentAlignment="Center"/>

                    <!-- Días Base -->
                    <TextBlock Grid.Column="5" Text="Base:" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource ColorTextMuted}"/>
                    <Button x:Name="BtnDecBase" Grid.Column="6" Content="◀" Width="26" Height="26" Padding="0" Click="BtnDecBase_Click" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtDaysBase" Grid.Column="7" Text="22" Width="36" Height="26" Padding="2" FontSize="12" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" IsReadOnly="True" BorderThickness="1,0" BorderBrush="{StaticResource ColorBorder}"/>
                    <Button x:Name="BtnIncBase" Grid.Column="8" Content="▶" Width="26" Height="26" Padding="0" Click="BtnIncBase_Click" VerticalAlignment="Center"/>

                    <!-- Días Extra -->
                    <TextBlock Grid.Column="10" Text="Extras:" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource ColorTextMuted}"/>
                    <Button x:Name="BtnDecExtras" Grid.Column="11" Content="◀" Width="26" Height="26" Padding="0" Click="BtnDecExtras_Click" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtDaysExtras" Grid.Column="12" Text="0" Width="36" Height="26" Padding="2" FontSize="12" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" IsReadOnly="True" BorderThickness="1,0" BorderBrush="{StaticResource ColorBorder}"/>
                    <Button x:Name="BtnIncExtras" Grid.Column="13" Content="▶" Width="26" Height="26" Padding="0" Click="BtnIncExtras_Click" VerticalAlignment="Center"/>

                    <!-- Resumen Consumo y ProgressBar -->
                    <Grid Grid.Column="15" Margin="10,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock x:Name="LabelQuotaSummary" Grid.Column="0" Text="Consumidos: 0 / 22 (Quedan: 22)" FontSize="12" FontWeight="Bold" Foreground="{StaticResource ColorAccent}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <ProgressBar x:Name="ProgressBarQuota" Grid.Column="1" Height="8" Minimum="0" Maximum="100" Value="0" Foreground="{StaticResource ColorAccent}" Background="#E2E8F0" BorderThickness="0" VerticalAlignment="Center" MaxWidth="280" HorizontalAlignment="Left" Width="200"/>
                    </Grid>
                </Grid>
            </Border>
        
            <!-- ================= PANEL PRINCIPAL (TabControl ocupando todo el ancho) ================= -->
            <TabControl x:Name="MainTabControl" Grid.Row="2" Background="Transparent" BorderThickness="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="HeaderTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <TextBlock Text="{TemplateBinding Content}" FontSize="14" FontWeight="SemiBold" Padding="12,6"/>
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <!-- PESTAÑA: Vista Calendario -->
                <TabItem Header="📅 Vista Calendario">
                    <Grid Margin="0,15,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Banner Informativo -->
                        <Border Grid.Row="0" Background="#EEF2FF" BorderBrush="{StaticResource ColorPrimary}" BorderThickness="4,0,0,0" CornerRadius="8" Padding="12,10" Margin="0,0,0,15">
                            <TextBlock Text="💡 Puedes marcar rangos de días haciendo click y arrastrando en los calendarios." Foreground="{StaticResource ColorPrimary}"/>
                        </Border>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Sección del Calendario (Izquierda) con su scroll -->
                            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
                                <!-- Grid dinámico de meses (configuración flexible) -->
                                <UniformGrid x:Name="MonthsGrid" Columns="2" Margin="0,0,0,20">
                                    <!-- Los meses se generarán e inyectarán por código según AppConfig -->
                                </UniformGrid>
                            </ScrollViewer>

                            <!-- Sección del Detalle Textual (Derecha) con su scroll -->
                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                                <!-- Detalle Textual de Vacaciones -->
                                <Border Style="{StaticResource CardStyle}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="🏖️ Detalle de Vacaciones" Style="{StaticResource CardHeaderStyle}"/>
                                        <!-- Contenedor para inyectar los rangos textuales -->
                                        <StackPanel x:Name="PanelVacacionesTexto" Margin="0,5,0,0">
                                            <!-- Se generará dinámicamente -->
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- PESTAÑA: Vista Gantt -->
                <TabItem Header="📊 Vista Tabla Gantt" Selector.Selected="TabGantt_Selected">
                    <Grid Margin="0,15,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Wrapper de scroll bidireccional para el Gantt -->
                        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Grid x:Name="GanttTableGrid" Margin="0,0,0,10">
                                <!-- Generado por código dinámicamente -->
                            </Grid>
                        </ScrollViewer>

                        <!-- Botones de Acción Extra / Leyendas de Gantt -->
                        <StackPanel Grid.Row="1" Margin="0,10,0,0">
                            <!-- Leyendas dinámicas -->
                            <WrapPanel x:Name="PanelLeyendaGantt" Orientation="Horizontal" Margin="0,0,0,10">
                                <!-- Se inyectará desde C# -->
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
        
    </DockPanel>
</Window>
