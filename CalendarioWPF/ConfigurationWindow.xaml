<Window x:Class="CalendarioWPF.ConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="⚙️ Configuración" Height="760" Width="760"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8FAFC" FontFamily="Segoe UI, Inter, Arial">

    <Window.Resources>
        <SolidColorBrush x:Key="ColorPrimary" Color="#6366F1"/>
        <SolidColorBrush x:Key="ColorPrimaryHover" Color="#4F46E5"/>
        <SolidColorBrush x:Key="ColorAccent" Color="#10B981"/>
        <SolidColorBrush x:Key="ColorDanger" Color="#EF4444"/>
        <SolidColorBrush x:Key="ColorBorder" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="ColorTextMain" Color="#0F172A"/>
        <SolidColorBrush x:Key="ColorTextMuted" Color="#64748B"/>

        <!-- Estilo de Botón Estándar -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource ColorTextMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ColorBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo Botón Primario -->
        <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource ColorPrimary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource ColorPrimaryHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo Botón Peligro -->
        <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource ColorDanger}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DC2626"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= CONTENIDO PRINCIPAL ================= -->
        <TabControl Grid.Row="0" Margin="12" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="HeaderTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <TextBlock Text="{TemplateBinding Content}" FontSize="14" FontWeight="SemiBold" Padding="12,6"/>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- ===== PESTAÑA 1: PERSONAL ===== -->
            <TabItem Header="👥 Personal">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Gestión del personal y cupos de vacaciones. Puedes editar directamente en la tabla (multiselección permitida)." 
                               FontSize="12" Foreground="{StaticResource ColorTextMuted}" Margin="0,0,0,10"/>

                    <DataGrid x:Name="DgTrabajadores" Grid.Row="1" 
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              Background="White" BorderBrush="{StaticResource ColorBorder}" BorderThickness="1"
                              RowHeight="32" ColumnHeaderHeight="34" FontSize="13"
                              SelectionMode="Extended" SelectionUnit="FullRow"
                              PreviewKeyDown="List_PreviewKeyDown">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nombre del Trabajador" Binding="{Binding Nombre}" Width="*" IsReadOnly="False"/>
                            <DataGridTextColumn Header="Departamento" Binding="{Binding Departamento}" Width="150" IsReadOnly="False"/>
                            <DataGridTextColumn Header="Días Base" Binding="{Binding DiasBase}" Width="80" IsReadOnly="False"/>
                            <DataGridTextColumn Header="Días Extras" Binding="{Binding DiasExtras}" Width="80" IsReadOnly="False"/>
                            <DataGridTextColumn Header="Vacaciones Usadas" Binding="{Binding VacacionesUsadas}" Width="130" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Panel de Acciones en Lote -->
                    <Border Grid.Row="2" Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="✏️ Acciones en Lote (para filas seleccionadas)" FontSize="12" FontWeight="Bold" Foreground="#3730A3" Margin="0,0,0,8"/>
                            <WrapPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <!-- Días Base -->
                                <StackPanel Orientation="Horizontal" Margin="0,5,15,0">
                                    <TextBlock Text="Base:" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox x:Name="TxtLoteBase" Text="22" Width="40" Padding="4" FontSize="12" HorizontalContentAlignment="Center" VerticalAlignment="Center"/>
                                    <Button Content="Asignar" Padding="6,2" FontSize="11" Click="BtnLoteAsignarBase_Click" Margin="6,0,4,0"/>
                                    <Button Content="➕" Padding="8,2" FontSize="11" Click="BtnLoteSumarBase_Click" Margin="0,0,4,0" ToolTip="Sumar días"/>
                                    <Button Content="➖" Padding="8,2" FontSize="11" Click="BtnLoteRestarBase_Click" ToolTip="Restar días"/>
                                </StackPanel>
                                
                                <!-- Días Extras -->
                                <StackPanel Orientation="Horizontal" Margin="0,5,15,0">
                                    <TextBlock Text="Extras:" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox x:Name="TxtLoteExtras" Text="0" Width="40" Padding="4" FontSize="12" HorizontalContentAlignment="Center" VerticalAlignment="Center"/>
                                    <Button Content="Asignar" Padding="6,2" FontSize="11" Click="BtnLoteAsignarExtras_Click" Margin="6,0,4,0"/>
                                    <Button Content="➕" Padding="8,2" FontSize="11" Click="BtnLoteSumarExtras_Click" Margin="0,0,4,0" ToolTip="Sumar días"/>
                                    <Button Content="➖" Padding="8,2" FontSize="11" Click="BtnLoteRestarExtras_Click" ToolTip="Restar días"/>
                                </StackPanel>

                                <!-- Departamento -->
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <TextBlock Text="Dpto:" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="CmbLoteDepartamento" Width="100" Padding="4" FontSize="12" VerticalAlignment="Center"/>
                                    <Button Content="Asignar" Padding="6,2" FontSize="11" Click="BtnLoteAsignarDepartamento_Click" Margin="6,0,0,0"/>
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
                        <TextBox x:Name="TxtNuevoTrabajador" Width="220" Padding="8,6" FontSize="13" VerticalContentAlignment="Center"/>
                        <Button Content="➕ Añadir" Margin="8,0,0,0" Click="BtnAddTrabajador_Click"/>
                        <Button Content="🗑️ Eliminar Seleccionado(s)" Style="{StaticResource BtnDanger}" Margin="8,0,0,0" Click="BtnRemoveTrabajador_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ===== PESTAÑA 2: FESTIVOS ===== -->
            <TabItem Header="🚩 Festivos">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Lista de festivos oficiales. Puedes editar, añadir o eliminar fechas directamente." 
                               FontSize="12" Foreground="{StaticResource ColorTextMuted}" Margin="0,0,0,10"/>

                    <DataGrid x:Name="DgFestivos" Grid.Row="1"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              Background="White" BorderBrush="{StaticResource ColorBorder}" BorderThickness="1"
                              RowHeight="32" ColumnHeaderHeight="34" FontSize="13"
                              SelectionMode="Extended" SelectionUnit="FullRow"
                              PreviewKeyDown="List_PreviewKeyDown">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Fecha (dd/MM/yyyy)" Binding="{Binding Fecha}" Width="150" IsReadOnly="False"/>
                            <DataGridTextColumn Header="Departamento" Binding="{Binding Departamento}" Width="*" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
                        <ComboBox x:Name="CmbNuevoFestivoDpto" Width="150" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,8,0">
                        </ComboBox>
                        <DatePicker x:Name="DpNuevoFestivo" Width="150" FontSize="13" VerticalContentAlignment="Center"/>
                        <Button Content="➕ Añadir Festivo" Margin="8,0,0,0" Click="BtnAddFestivo_Click"/>
                        <Button Content="🗑️ Eliminar Seleccionado(s)" Style="{StaticResource BtnDanger}" Margin="8,0,0,0" Click="BtnRemoveFestivo_Click"/>
                    </StackPanel>
                    
                    <!-- Sección importar festivos de CCAA -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,15,0,0">
                        <TextBlock Text="Importar de CCAA:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" Foreground="{StaticResource ColorTextMuted}" />
                        <ComboBox x:Name="CbRegiones" Width="200" DisplayMemberPath="Value" SelectedValuePath="Key" />
                        <Button Content="📥 Importar Festivos" Margin="8,0,0,0" Click="BtnImportarFestivosCCAA_Click" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ===== PESTAÑA: DEPARTAMENTOS ===== -->
            <TabItem Header="🏢 Departamentos">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="Gestión de Departamentos y Cierres patronales." 
                               FontSize="12" Foreground="{StaticResource ColorTextMuted}" Margin="0,0,0,10"/>
                    
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <ListBox x:Name="LstDepartamentos" Grid.Column="0" Margin="0,0,10,0" SelectionChanged="LstDepartamentos_SelectionChanged" PreviewKeyDown="List_PreviewKeyDown">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="txtContent" Text="{Binding}"/>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding}" Value="__todos__">
                                            <Setter TargetName="txtContent" Property="Text" Value="General (Toda la Empresa)"/>
                                            <Setter TargetName="txtContent" Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        
                        <StackPanel Grid.Column="1" IsEnabled="False" x:Name="PanelDetalleDepartamento">
                            <TextBlock Text="Cierres de Empresa (días obligatorios para el departamento):" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <ListBox x:Name="LstCierresDpto" Height="200" Margin="0,0,0,10" PreviewKeyDown="List_PreviewKeyDown"/>
                            
                            <StackPanel Orientation="Horizontal">
                                <Calendar x:Name="CalCierreDpto" SelectionMode="MultipleRange" Margin="0,0,10,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <Button Content="➕ Añadir Seleccionados" Margin="0,0,0,10" Click="BtnAddCierreDpto_Click"/>
                                    <Button Content="🗑️ Eliminar de lista" Style="{StaticResource BtnDanger}" Click="BtnRemoveCierreDpto_Click"/>
                                </StackPanel>
                            </StackPanel>
                            
                            <CheckBox x:Name="ChkDptoIncompatible" Content="Incompatibilidad total (nadie del depto puede coincidir)" Margin="0,15,0,0" Checked="ChkDptoIncompatible_Checked" Unchecked="ChkDptoIncompatible_Checked"/>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                                <TextBlock Text="Color Base (PDF):" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox x:Name="CmbDptoColor" Width="150" SelectionChanged="CmbDptoColor_SelectionChanged">
                                    <ComboBoxItem Content="Gris (Por defecto)" Tag="#E2E8F0"/>
                                    <ComboBoxItem Content="Lavanda" Tag="#E6E6FA"/>
                                    <ComboBoxItem Content="Naranja" Tag="#FFDAB9"/>
                                    <ComboBoxItem Content="Verde" Tag="#E0F8E0"/>
                                    <ComboBoxItem Content="Azul" Tag="#D0E8FF"/>
                                    <ComboBoxItem Content="Amarillo" Tag="#FFFACD"/>
                                    <ComboBoxItem Content="Rosa" Tag="#FFE4E1"/>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBox x:Name="TxtNuevoDpto" Width="150" Margin="0,0,10,0" VerticalContentAlignment="Center"/>
                        <Button Content="➕ Añadir Dpto" Click="BtnAddDpto_Click"/>
                        <Button Content="🗑️ Eliminar Dpto" Margin="10,0,0,0" Style="{StaticResource BtnDanger}" Click="BtnRemoveDpto_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ===== PESTAÑA: INCOMPATIBILIDADES ===== -->
            <TabItem Header="🚫 Incompatibilidades">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="Selecciona un trabajador y añade las personas con las que no puede coincidir en vacaciones." 
                               FontSize="12" Foreground="{StaticResource ColorTextMuted}" Margin="0,0,0,10"/>
                               
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <ListBox x:Name="LstTrabajadoresIncomp" Grid.Column="0" Margin="0,0,10,0" SelectionChanged="LstTrabajadoresIncomp_SelectionChanged"/>
                        
                        <StackPanel Grid.Column="1" IsEnabled="False" x:Name="PanelDetalleIncomp">
                            <TextBlock Text="No puede coincidir con:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <ListBox x:Name="LstIncompatibles" Height="200" Margin="0,0,0,10" PreviewKeyDown="List_PreviewKeyDown"/>
                            
                            <StackPanel Orientation="Horizontal">
                                <ComboBox x:Name="CmbTrabajadorIncompatible" Width="180" VerticalContentAlignment="Center"/>
                                <Button Content="➕ Añadir" Margin="10,0,0,0" Click="BtnAddIncomp_Click"/>
                                <Button Content="🗑️ Eliminar" Margin="10,0,0,0" Style="{StaticResource BtnDanger}" Click="BtnRemoveIncomp_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ===== PESTAÑA: EXPORTACIÓN Y VISUALIZACIÓN ===== -->
            <TabItem Header="📄 Exportación y Visualización">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
                    <StackPanel>
                        <!-- Sección: Metadatos PDF -->
                        <TextBlock Text="📝 Metadatos de Exportación PDF" FontSize="14" FontWeight="Bold" 
                                    Foreground="{StaticResource ColorTextMain}" Margin="0,0,0,10"/>

                        <TextBlock Text="Método de Persistencia de Datos:" FontSize="12" FontWeight="SemiBold" 
                                   Foreground="{StaticResource ColorTextMuted}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CbPersistencia" Height="34" FontSize="13" Margin="0,0,0,14">
                            <ComboBoxItem Content="SQLite (Recomendado para multiempresa)"/>
                            <ComboBoxItem Content="JSON (Modo legado)"/>
                        </ComboBox>

                        <TextBlock Text="Título del Calendario / Página:" FontSize="12" FontWeight="SemiBold" 
                                   Foreground="{StaticResource ColorTextMuted}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtTituloCalendario" Padding="8,6" FontSize="13" Margin="0,0,0,14"/>

                        <TextBlock Text="Pie de página del PDF:" FontSize="12" FontWeight="SemiBold" 
                                   Foreground="{StaticResource ColorTextMuted}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtPiePagina" Padding="8,6" FontSize="13" Margin="0,0,0,14"/>

                        <TextBlock Text="Orientación del PDF Mensual:" FontSize="12" FontWeight="SemiBold" 
                                   Foreground="{StaticResource ColorTextMuted}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CbOrientacion" Height="34" FontSize="13" Margin="0,0,0,14">
                            <ComboBoxItem Content="Vertical (Portrait)"/>
                            <ComboBoxItem Content="Horizontal (Landscape)"/>
                        </ComboBox>

                        <CheckBox x:Name="ChkOcultarComputo" Content="Ocultar fila de cómputos netos al pie de la tabla Gantt" 
                                  FontSize="13" Margin="0,0,0,10"/>

                        <CheckBox x:Name="ChkOcultarMesesSinDias" Content="Ocultar meses sin días marcados (vacaciones o festivos) en el PDF" 
                                  FontSize="13" Margin="0,0,0,10"/>

                        <CheckBox x:Name="ChkForzarSaltoPagina" Content="Forzar salto de página al cambiar de año y antes del resumen en el PDF" 
                                  FontSize="13" Margin="0,0,0,10"/>

                        <CheckBox x:Name="ChkExportarMultiplesPdfs" Content="Generar archivos PDF independientes por cada año (en lugar de consolidado)" 
                                  FontSize="13" Margin="0,0,0,14"/>

                        <TextBlock Text="Año de Vacaciones Activo (Imputación del Cupo):" FontSize="12" FontWeight="SemiBold" 
                                   Foreground="{StaticResource ColorTextMuted}" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Button x:Name="BtnDecActiveYear" Content="◀" Width="30" Padding="0,4" FontSize="12" Click="BtnDecActiveYear_Click"/>
                            <TextBox x:Name="TxtAnoActivo" Width="80" Padding="8,6" FontSize="13" TextAlignment="Center" IsReadOnly="True" IsTabStop="False" Background="#F1F5F9" BorderBrush="{StaticResource ColorBorder}"/>
                            <Button x:Name="BtnIncActiveYear" Content="▶" Width="30" Padding="0,4" FontSize="12" Click="BtnIncActiveYear_Click"/>
                        </StackPanel>

                        <TextBlock Text="Años a incluir en las exportaciones (Histórico):" FontSize="12" FontWeight="SemiBold" 
                                   Foreground="{StaticResource ColorTextMuted}" Margin="0,0,0,4"/>
                        <TextBlock Text="Selecciona qué años se procesarán. Si no marcas ninguno, se exportarán todos los años con datos." 
                                   FontSize="11" Foreground="{StaticResource ColorTextMuted}" Margin="0,0,0,6"/>
                        <StackPanel x:Name="PanelAnosAExportar" Margin="0,0,0,14">
                            <!-- Se rellenará dinámicamente por código -->
                        </StackPanel>

                        <!-- Separador -->
                        <Separator Margin="0,0,0,16" Background="{StaticResource ColorBorder}"/>

                        <!-- Sección: Meses a Mostrar -->
                        <TextBlock Text="📅 Meses a Mostrar (Calendario y PDF Mensual)" FontSize="14" FontWeight="Bold" 
                                   Foreground="{StaticResource ColorTextMain}" Margin="0,0,0,10"/>
                        <TextBlock Text="Selecciona los meses que se visualizarán en la Vista Calendario y en las exportaciones PDF." 
                                   FontSize="12" Foreground="{StaticResource ColorTextMuted}" Margin="0,0,0,10"/>

                        <UniformGrid Columns="4" Margin="0,0,0,10">
                            <CheckBox x:Name="ChkMes1" Content="Enero" FontSize="13" Margin="0,4"/>
                            <CheckBox x:Name="ChkMes2" Content="Febrero" FontSize="13" Margin="0,4"/>
                            <CheckBox x:Name="ChkMes3" Content="Marzo" FontSize="13" Margin="0,4"/>
                            <CheckBox x:Name="ChkMes4" Content="Abril" FontSize="13" Margin="0,4"/>
                            <CheckBox x:Name="ChkMes5" Content="Mayo" FontSize="13" Margin="0,4"/>
                            <CheckBox x:Name="ChkMes6" Content="Junio" FontSize="13" Margin="0,4"/>
                            <CheckBox x:Name="ChkMes7" Content="Julio" FontSize="13" Margin="0,4"/>
                            <CheckBox x:Name="ChkMes8" Content="Agosto" FontSize="13" Margin="0,4"/>
                            <CheckBox x:Name="ChkMes9" Content="Septiembre" FontSize="13" Margin="0,4"/>
                            <CheckBox x:Name="ChkMes10" Content="Octubre" FontSize="13" Margin="0,4"/>
                            <CheckBox x:Name="ChkMes11" Content="Noviembre" FontSize="13" Margin="0,4"/>
                            <CheckBox x:Name="ChkMes12" Content="Diciembre" FontSize="13" Margin="0,4"/>
                        </UniformGrid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,4,0,0">
                            <Button Content="Seleccionar Todos" Click="BtnSelectAllMeses_Click" Margin="0,0,8,0"/>
                            <Button Content="Deseleccionar Todos" Click="BtnDeselectAllMeses_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- ================= BARRA INFERIOR DE ACCIONES ================= -->
        <Border Grid.Row="1" BorderBrush="{StaticResource ColorBorder}" BorderThickness="0,1,0,0" Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Width="100" Click="BtnCancelar_Click" Margin="0,0,10,0"/>
                <Button Content="✅ Aceptar" Width="120" Style="{StaticResource BtnPrimary}" Click="BtnAceptar_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
