<Window x:Class="CalendarioWPF.Dialogs.LimpiarDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Limpiar Datos" SizeToContent="Height" MinHeight="300" Width="400"
        WindowStartupLocation="CenterOwner" Background="#F8FAFC"
        FontFamily="Segoe UI, Inter, Arial" ResizeMode="NoResize"
        ShowInTaskbar="False">
    
    <Window.Resources>
        <!-- Estilo Botón Primario -->
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background" Value="#6366F1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4F46E5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnSecondary" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="🧹 Limpiar Datos del Planificador" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10"/>
        
        <TextBlock Grid.Row="1" Text="Selecciona qué datos deseas eliminar del planificador actual. Esta acción no se puede deshacer." TextWrapping="Wrap" Foreground="#64748B" Margin="0,0,0,20"/>
        
        <StackPanel Grid.Row="2" Margin="10,0,0,0">
            <CheckBox x:Name="ChkFestivos" Content="Eliminar todos los Festivos Oficiales" FontSize="14" Margin="0,0,0,10" Foreground="#0F172A"/>
            <CheckBox x:Name="ChkVacaciones" Content="Eliminar todas las Vacaciones asignadas" FontSize="14" Margin="0,0,0,10" Foreground="#0F172A"/>
            <CheckBox x:Name="ChkTrabajadores" Content="Eliminar todos los Trabajadores y sus cupos" FontSize="14" Margin="0,0,0,10" Foreground="#0F172A" Checked="ChkTrabajadores_Checked" Unchecked="ChkTrabajadores_Checked"/>
            <TextBlock x:Name="TxtAviso" Text="* Eliminar trabajadores también eliminará sus vacaciones." FontSize="12" Foreground="#EF4444" Margin="22,0,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Cancelar" Style="{StaticResource BtnSecondary}" Width="90" Margin="0,0,10,0" Click="BtnCancelar_Click"/>
            <Button Content="Limpiar" Style="{StaticResource BtnPrimary}" Width="90" Background="#EF4444" Click="BtnLimpiar_Click"/>
        </StackPanel>
    </Grid>
</Window>
